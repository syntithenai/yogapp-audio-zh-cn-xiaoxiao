{
  "id": "self-compassion-10",
  "voiceId": "zh-cn-xiaoxiao",
  "edgeVoice": "zh-CN-XiaoxiaoNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 165,
  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.184
    },
    {
      "index": 1,
      "text": "需要时间到达。",
      "file": "c001.ogg",
      "durationSec": 3.36
    },
    {
      "index": 2,
      "text": "在支撑下坐下或躺下。",
      "file": "c002.ogg",
      "durationSec": 4.488
    },
    {
      "index": 3,
      "text": "如果感觉安全，请闭上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.352
    },
    {
      "index": 4,
      "text": "感受与地面的接触。",
      "file": "c004.ogg",
      "durationSec": 3.888
    },
    {
      "index": 5,
      "text": "缓慢吸气。",
      "file": "c005.ogg",
      "durationSec": 2.904
    },
    {
      "index": 6,
      "text": "呼气时间更长。",
      "file": "c006.ogg",
      "durationSec": 3.432
    },
    {
      "index": 7,
      "text": "[暂停：26]",
      "file": "c007.ogg",
      "durationSec": 3.6
    },
    {
      "index": 8,
      "text": "再次。",
      "file": "c008.ogg",
      "durationSec": 2.184
    },
    {
      "index": 9,
      "text": "[暂停：26]",
      "file": "c009.ogg",
      "durationSec": 3.6
    },
    {
      "index": 10,
      "text": "让肩膀下垂。",
      "file": "c010.ogg",
      "durationSec": 3.288
    },
    {
      "index": 11,
      "text": "让腹部变软。",
      "file": "c011.ogg",
      "durationSec": 2.976
    },
    {
      "index": 12,
      "text": "[暂停：32]",
      "file": "c012.ogg",
      "durationSec": 3.6
    },
    {
      "index": 13,
      "text": "把手放在心上，如果有帮助的话。",
      "file": "c013.ogg",
      "durationSec": 5.904
    },
    {
      "index": 14,
      "text": "不加评判地注意你的状态。",
      "file": "c014.ogg",
      "durationSec": 4.992
    },
    {
      "index": 15,
      "text": "[暂停：32]",
      "file": "c015.ogg",
      "durationSec": 3.6
    },
    {
      "index": 16,
      "text": "这是一个痛苦的时刻，或者说是普通人类的压力时刻。",
      "file": "c016.ogg",
      "durationSec": 8.808
    },
    {
      "index": 17,
      "text": "其他人也有这样的感觉。",
      "file": "c017.ogg",
      "durationSec": 4.128
    },
    {
      "index": 18,
      "text": "[暂停：39]",
      "file": "c018.ogg",
      "durationSec": 3.768
    },
    {
      "index": 19,
      "text": "愿此刻我善待自己。",
      "file": "c019.ogg",
      "durationSec": 4.032
    },
    {
      "index": 20,
      "text": "[暂停：32]",
      "file": "c020.ogg",
      "durationSec": 3.6
    },
    {
      "index": 21,
      "text": "愿我接受现在的自己。",
      "file": "c021.ogg",
      "durationSec": 4.104
    },
    {
      "index": 22,
      "text": "[暂停：32]",
      "file": "c022.ogg",
      "durationSec": 3.6
    },
    {
      "index": 23,
      "text": "愿我给予自己我所需要的同情心。",
      "file": "c023.ogg",
      "durationSec": 5.856
    },
    {
      "index": 24,
      "text": "[暂停：39]",
      "file": "c024.ogg",
      "durationSec": 3.768
    },
    {
      "index": 25,
      "text": "重复落地的短语。留下那些不这样做的。",
      "file": "c025.ogg",
      "durationSec": 7.344
    },
    {
      "index": 26,
      "text": "[暂停：52]",
      "file": "c026.ogg",
      "durationSec": 3.456
    },
    {
      "index": 27,
      "text": "想象一下，像一位明智的朋友一样对自己说话。",
      "file": "c027.ogg",
      "durationSec": 7.944
    },
    {
      "index": 28,
      "text": "他们会用什么语气？",
      "file": "c028.ogg",
      "durationSec": 3.48
    },
    {
      "index": 29,
      "text": "现在就给自己这样的语气。",
      "file": "c029.ogg",
      "durationSec": 4.632
    },
    {
      "index": 30,
      "text": "[暂停：65]",
      "file": "c030.ogg",
      "durationSec": 3.648
    },
    {
      "index": 31,
      "text": "吸入善意。",
      "file": "c031.ogg",
      "durationSec": 2.808
    },
    {
      "index": 32,
      "text": "呼出粗重的气息。",
      "file": "c032.ogg",
      "durationSec": 3.648
    },
    {
      "index": 33,
      "text": "[暂停：78]",
      "file": "c033.ogg",
      "durationSec": 3.552
    },
    {
      "index": 34,
      "text": "[暂停：39]",
      "file": "c034.ogg",
      "durationSec": 3.768
    },
    {
      "index": 35,
      "text": "开始加深呼吸。",
      "file": "c035.ogg",
      "durationSec": 3.456
    },
    {
      "index": 36,
      "text": "再次感受一下房间。",
      "file": "c036.ogg",
      "durationSec": 3.84
    },
    {
      "index": 37,
      "text": "摆动手指和脚趾。",
      "file": "c037.ogg",
      "durationSec": 3.84
    },
    {
      "index": 38,
      "text": "准备好后，睁开眼睛。",
      "file": "c038.ogg",
      "durationSec": 4.44
    },
    {
      "index": 39,
      "text": "慢慢地进入接下来的事情。",
      "file": "c039.ogg",
      "durationSec": 4.512
    }
  ]
}
