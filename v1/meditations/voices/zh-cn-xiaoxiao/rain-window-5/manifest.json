{
  "id": "rain-window-5",
  "voiceId": "zh-cn-xiaoxiao",
  "edgeVoice": "zh-CN-XiaoxiaoNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 113,
  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.184
    },
    {
      "index": 1,
      "text": "找一个舒适的座位，或者如果感觉好一点的话就躺下来。",
      "file": "c001.ogg",
      "durationSec": 8.784
    },
    {
      "index": 2,
      "text": "让双手休息一下。",
      "file": "c002.ogg",
      "durationSec": 3.48
    },
    {
      "index": 3,
      "text": "软化眼睛，或闭上眼睛。",
      "file": "c003.ogg",
      "durationSec": 4.944
    },
    {
      "index": 4,
      "text": "缓慢吸气。",
      "file": "c004.ogg",
      "durationSec": 2.904
    },
    {
      "index": 5,
      "text": "并且呼气时间更长。",
      "file": "c005.ogg",
      "durationSec": 4.368
    },
    {
      "index": 6,
      "text": "想象一下在一个安静的雨天坐在窗边。",
      "file": "c006.ogg",
      "durationSec": 6.792
    },
    {
      "index": 7,
      "text": "玻璃凉了外面的世界柔软。",
      "file": "c007.ogg",
      "durationSec": 4.536
    },
    {
      "index": 8,
      "text": "[停顿：30]",
      "file": "c008.ogg",
      "durationSec": 3.528
    },
    {
      "index": 9,
      "text": "无需故事，就能听雨声。",
      "file": "c009.ogg",
      "durationSec": 4.728
    },
    {
      "index": 10,
      "text": "小水龙头。偶尔会摔倒较重。",
      "file": "c010.ogg",
      "durationSec": 6.456
    },
    {
      "index": 11,
      "text": "[暂停：36]",
      "file": "c011.ogg",
      "durationSec": 3.648
    },
    {
      "index": 12,
      "text": "闻到干净潮湿的空气。",
      "file": "c012.ogg",
      "durationSec": 4.32
    },
    {
      "index": 13,
      "text": "见灰色的光芒，温柔而从容。",
      "file": "c013.ogg",
      "durationSec": 5.376
    },
    {
      "index": 14,
      "text": "[停顿：30]",
      "file": "c014.ogg",
      "durationSec": 3.528
    },
    {
      "index": 15,
      "text": "雨天无处可去。",
      "file": "c015.ogg",
      "durationSec": 3.408
    },
    {
      "index": 16,
      "text": "允许暂停。",
      "file": "c016.ogg",
      "durationSec": 2.88
    },
    {
      "index": 17,
      "text": "[暂停：36]",
      "file": "c017.ogg",
      "durationSec": 3.648
    },
    {
      "index": 18,
      "text": "随着水在玻璃上的节奏呼吸。",
      "file": "c018.ogg",
      "durationSec": 5.136
    },
    {
      "index": 19,
      "text": "[暂停：45]",
      "file": "c019.ogg",
      "durationSec": 3.672
    },
    {
      "index": 20,
      "text": "让神经系统接受提示：软化。",
      "file": "c020.ogg",
      "durationSec": 5.808
    },
    {
      "index": 21,
      "text": "[暂停：36]",
      "file": "c021.ogg",
      "durationSec": 3.648
    },
    {
      "index": 22,
      "text": "再轻松地吸一口气。",
      "file": "c022.ogg",
      "durationSec": 3.96
    },
    {
      "index": 23,
      "text": "动动手指。",
      "file": "c023.ogg",
      "durationSec": 2.76
    },
    {
      "index": 24,
      "text": "准备好后，睁开眼睛。",
      "file": "c024.ogg",
      "durationSec": 4.44
    },
    {
      "index": 25,
      "text": "随身携带一点这个。",
      "file": "c025.ogg",
      "durationSec": 3.768
    }
  ]
}
