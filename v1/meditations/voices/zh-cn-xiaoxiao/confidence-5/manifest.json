  "totalSec": 132,
  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.184
    },
    {
      "index": 1,
      "text": "找一个舒适的座位，或者如果感觉好一点的话就躺下来。",
      "file": "c001.ogg",
      "durationSec": 8.784
    },
    {
      "index": 2,
      "text": "让双手休息一下。",
      "file": "c002.ogg",
      "durationSec": 3.48
    },
    {
      "index": 3,
      "text": "软化眼睛，或闭上眼睛。",
      "file": "c003.ogg",
      "durationSec": 4.944
    },
    {
      "index": 4,
      "text": "缓慢吸气。",
      "file": "c004.ogg",
      "durationSec": 2.904
    },
    {
      "index": 5,
      "text": "并且呼气时间更长。",
      "file": "c005.ogg",
      "durationSec": 4.368
    },
    {
      "index": 6,
      "text": "感觉坐骨或脚。",
      "file": "c006.ogg",
      "durationSec": 3.408
    },
    {
      "index": 7,
      "text": "你脚下有一个稳定的基础。",
      "file": "c007.ogg",
      "durationSec": 4.608
    },
    {
      "index": 8,
      "text": "[暂停：22]",
      "file": "c008.ogg",
      "durationSec": 3.552
    },
    {
      "index": 9,
      "text": "延长脊柱而不硬化。",
      "file": "c009.ogg",
      "durationSec": 4.368
    },
    {
      "index": 10,
      "text": "脸软软的。软软的肚子。中锋强。",
      "file": "c010.ogg",
      "durationSec": 7.944
    },
    {
      "index": 11,
      "text": "[暂停：22]",
      "file": "c011.ogg",
      "durationSec": 3.552
    },
    {
      "index": 12,
      "text": "默默地尝试这些短语，或者只是听。",
      "file": "c012.ogg",
      "durationSec": 6.216
    },
    {
      "index": 13,
      "text": "我能遇见我该遇见的。",
      "file": "c013.ogg",
      "durationSec": 3.792
    },
    {
      "index": 14,
      "text": "[暂停：22]",
      "file": "c014.ogg",
      "durationSec": 3.552
    },
    {
      "index": 15,
      "text": "我不需要急于成为我的人。",
      "file": "c015.ogg",
      "durationSec": 4.488
    },
    {
      "index": 16,
      "text": "[暂停：22]",
      "file": "c016.ogg",
      "durationSec": 3.552
    },
    {
      "index": 17,
      "text": "我相信我的下一步是诚实的。",
      "file": "c017.ogg",
      "durationSec": 5.064
    },
    {
      "index": 18,
      "text": "[暂停：28]",
      "file": "c018.ogg",
      "durationSec": 3.6
    },
    {
      "index": 19,
      "text": "呼吸自信，就像胸中的温暖，而不是盔甲。",
      "file": "c019.ogg",
      "durationSec": 7.632
    },
    {
      "index": 20,
      "text": "[暂停：28]",
      "file": "c020.ogg",
      "durationSec": 3.6
    },
    {
      "index": 21,
      "text": "想象自己能够稳定地应对一项普通的挑战。",
      "file": "c021.ogg",
      "durationSec": 7.104
    },
    {
      "index": 22,
      "text": "[暂停：33]",
      "file": "c022.ogg",
      "durationSec": 3.672
    },
    {
      "index": 23,
      "text": "回到呼吸。",
      "file": "c023.ogg",
      "durationSec": 2.688
    },
    {
      "index": 24,
      "text": "稳定的。足够的。",
      "file": "c024.ogg",
      "durationSec": 4.536
    },
    {
      "index": 25,
      "text": "[暂停：28]",
      "file": "c025.ogg",
      "durationSec": 3.6
    },
    {
      "index": 26,
      "text": "再轻松地吸一口气。",
      "file": "c026.ogg",
      "durationSec": 3.96
    },
    {
      "index": 27,
      "text": "动动手指。",
      "file": "c027.ogg",
      "durationSec": 2.76
    },
    {
      "index": 28,
      "text": "准备好后，睁开眼睛。",
      "file": "c028.ogg",
      "durationSec": 4.44
    },
    {
      "index": 29,
      "text": "随身携带一点这个。",
      "file": "c029.ogg",
      "durationSec": 3.768
    }
  ]
}
