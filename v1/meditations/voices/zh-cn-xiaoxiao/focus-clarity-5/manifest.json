  "chunks": [
    {
      "index": 0,
      "text": "欢迎。",
      "file": "c000.ogg",
      "durationSec": 2.184
    },
    {
      "index": 1,
      "text": "找一个舒适的座位，或者如果感觉好一点的话就躺下来。",
      "file": "c001.ogg",
      "durationSec": 8.784
    },
    {
      "index": 2,
      "text": "让双手休息一下。",
      "file": "c002.ogg",
      "durationSec": 3.48
    },
    {
      "index": 3,
      "text": "软化眼睛，或闭上眼睛。",
      "file": "c003.ogg",
      "durationSec": 4.944
    },
    {
      "index": 4,
      "text": "缓慢吸气。",
      "file": "c004.ogg",
      "durationSec": 2.904
    },
    {
      "index": 5,
      "text": "并且呼气时间更长。",
      "file": "c005.ogg",
      "durationSec": 4.368
    },
    {
      "index": 6,
      "text": "选择一个锚点。鼻孔的呼吸，或者腹部的起伏。",
      "file": "c006.ogg",
      "durationSec": 8.808
    },
    {
      "index": 7,
      "text": "在那里休息。",
      "file": "c007.ogg",
      "durationSec": 2.904
    },
    {
      "index": 8,
      "text": "[暂停：23]",
      "file": "c008.ogg",
      "durationSec": 3.672
    },
    {
      "index": 9,
      "text": "当心走神时，注意它去了哪里。",
      "file": "c009.ogg",
      "durationSec": 5.448
    },
    {
      "index": 10,
      "text": "然后返回。亲切地。干净利落。",
      "file": "c010.ogg",
      "durationSec": 7.56
    },
    {
      "index": 11,
      "text": "[暂停：29]",
      "file": "c011.ogg",
      "durationSec": 3.696
    },
    {
      "index": 12,
      "text": "回归就是训练。",
      "file": "c012.ogg",
      "durationSec": 3.432
    },
    {
      "index": 13,
      "text": "吸入。停留。",
      "file": "c013.ogg",
      "durationSec": 4.176
    },
    {
      "index": 14,
      "text": "呼气。停留。",
      "file": "c014.ogg",
      "durationSec": 4.248
    },
    {
      "index": 15,
      "text": "[暂停：34]",
      "file": "c015.ogg",
      "durationSec": 3.696
    },
    {
      "index": 16,
      "text": "如果有帮助，请将呼吸数到五次，然后重新开始。",
      "file": "c016.ogg",
      "durationSec": 8.376
    },
    {
      "index": 17,
      "text": "一。",
      "file": "c017.ogg",
      "durationSec": 2.088
    },
    {
      "index": 18,
      "text": "[暂停：17]",
      "file": "c018.ogg",
      "durationSec": 3.48
    },
    {
      "index": 19,
      "text": "二。",
      "file": "c019.ogg",
      "durationSec": 2.088
    },
    {
      "index": 20,
      "text": "[暂停：17]",
      "file": "c020.ogg",
      "durationSec": 3.48
    },
    {
      "index": 21,
      "text": "三。",
      "file": "c021.ogg",
      "durationSec": 2.088
    },
    {
      "index": 22,
      "text": "[暂停：17]",
      "file": "c022.ogg",
      "durationSec": 3.48
    },
    {
      "index": 23,
      "text": "四。",
      "file": "c023.ogg",
      "durationSec": 2.088
    },
    {
      "index": 24,
      "text": "[暂停：17]",
      "file": "c024.ogg",
      "durationSec": 3.48
    },
    {
      "index": 25,
      "text": "五。",
      "file": "c025.ogg",
      "durationSec": 2.088
    },
    {
      "index": 26,
      "text": "[暂停：23]",
      "file": "c026.ogg",
      "durationSec": 3.672
    },
    {
      "index": 27,
      "text": "释放计数。",
      "file": "c027.ogg",
      "durationSec": 2.904
    },
    {
      "index": 28,
      "text": "暂时保持清醒、开放的注意力。",
      "file": "c028.ogg",
      "durationSec": 5.64
    },
    {
      "index": 29,
      "text": "[暂停：34]",
      "file": "c029.ogg",
      "durationSec": 3.696
    },
    {
      "index": 30,
      "text": "再轻松地吸一口气。",
      "file": "c030.ogg",
      "durationSec": 3.96
    },
    {
      "index": 31,
      "text": "动动手指。",
      "file": "c031.ogg",
      "durationSec": 2.76
    },
    {
      "index": 32,
      "text": "准备好后，睁开眼睛。",
      "file": "c032.ogg",
      "durationSec": 4.44
    },
    {
      "index": 33,
      "text": "随身携带一点这个。",
      "file": "c033.ogg",
      "durationSec": 3.768
    }
